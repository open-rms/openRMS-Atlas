DATABASE_URL=postgres://openrms:openrms@127.0.0.1:5442/openrms
PORT=8787
# Listen address. Production: 127.0.0.1 behind the reverse proxy. 0.0.0.0 only if the proxy is on another host.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
TRUSTED_ORIGINS=http://localhost:5173

# Production: request your own key from the Winlink Development Team. Do not reuse Pat's.
WINLINK_API_KEY=
# Development: import a local copy instead of calling api.winlink.org
WINLINK_FIXTURE=fixtures/winlink-gateway-status.sample.json.gz
# Only codes that are public in the service_code table are imported; never add private group codes.
WINLINK_SERVICE_CODES=PUBLIC,MERCURY,XARA,DATA2G,EMCOMM
# Real client IP header, honoured only for requests from the local reverse proxy (e.g. cf-connecting-ip).
TRUSTED_IP_HEADERS=
# Per-IP hourly allowance for requests naming non-public service codes.
UNLISTED_CODES_PER_HOUR=60
WINLINK_POLL_MINUTES=60
WINLINK_PUBLISH=true


# Identity: openRMS-Accounts. Production: OPENRMS_ISSUER=https://auth.openrms.dev only.
# Development: Accounts on 8789 plus the test issuer (scripts/dev-issuer.ts) for the smoke tests.
OPENRMS_ISSUER=http://localhost:8789,http://localhost:8799
# Production: https://atlas.openrms.dev. Development: Accounts issues dev tokens for http://localhost:8787.
OPENRMS_AUDIENCE=http://localhost:8787
# Must match Atlas subscriber secret configured in Accounts
ACCOUNTS_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Atlas's OAuth client at Accounts, for the timed account reconcile (dev: openRMS-Accounts/.dev-clients.env)
ACCOUNTS_CLIENT_ID=
ACCOUNTS_CLIENT_SECRET=
# Development: refresh the fixture before each import (uses your installed Pat; never in production)
# WINLINK_FIXTURE_REFRESH_CMD=scripts/fetch-winlink-via-pat.sh
