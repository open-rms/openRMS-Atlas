{
  "name": "openrms-directory",
  "version": "0.1.0",
  "description": "Open, API-first directory of radio email gateways, every mode",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-validator": "^0.9.1",
    "@openrms/service-auth": "link:../openRMS-Accounts/packages/service-auth",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true
}
